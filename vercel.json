{
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    {
      "source": "/mcp",
      "destination": "/api/mcp"
    },
    {
      "source": "/.well-known/oauth-protected-resource",
      "destination": "/api?action=oauth-protected-resource"
    },
    {
      "source": "/.well-known/oauth-protected-resource/mcp",
      "destination": "/api?action=oauth-protected-resource"
    },
    {
      "source": "/.well-known/oauth-authorization-server",
      "destination": "/api?action=oauth-authorization-server"
    },
    {
      "source": "/api/auth",
      "destination": "/api?action=auth"
    },
    {
      "source": "/oauth/authorize",
      "destination": "/oauth-authorize"
    },
    {
      "source": "/api/oauth/authorize",
      "destination": "/api?action=oauth-authorize"
    },
    {
      "source": "/api/oauth/token",
      "destination": "/api?action=oauth-token"
    },
    {
      "source": "/api/register",
      "destination": "/api?action=register"
    },
    {
      "source": "/api/recover",
      "destination": "/api?action=recover"
    },
    {
      "source": "/api/billing",
      "destination": "/api?action=billing"
    },
    {
      "source": "/api/stripe/webhook",
      "destination": "/api?action=stripe-webhook"
    },
    {
      "source": "/api/cases",
      "destination": "/api?action=cases"
    },
    {
      "source": "/api/config",
      "destination": "/api?action=config"
    },
    {
      "source": "/api/review",
      "destination": "/api?action=review"
    },
    {
      "source": "/api/admin/users",
      "destination": "/api?action=admin-users"
    },
    {
      "source": "/api/gpt/cases",
      "destination": "/api?action=gpt-cases"
    },
    {
      "source": "/api/gpt/case",
      "destination": "/api?action=gpt-case"
    },
    {
      "source": "/api/gpt/analysis",
      "destination": "/api?action=gpt-analysis"
    },
    {
      "source": "/api/gpt/analysis-start",
      "destination": "/api?action=gpt-analysis-start"
    },
    {
      "source": "/api/gpt/analysis-point",
      "destination": "/api?action=gpt-analysis-point"
    },
    {
      "source": "/api/gpt/analysis-finalize",
      "destination": "/api?action=gpt-analysis-finalize"
    },
    {
      "source": "/api/gpt/source-status",
      "destination": "/api?action=source-status"
    },
    {
      "source": "/api/gpt/legal-sources",
      "destination": "/api?action=legal-sources"
    },
    {
      "source": "/api/gpt/test-import",
      "destination": "/api?action=test-import"
    },
    {
      "source": "/api/test-import",
      "destination": "/api?action=test-import-ui"
    },
    {
      "source": "/api/gpt/analysis-history",
      "destination": "/api?action=gpt-analysis-history"
    },
    {
      "source": "/api/gpt/analysis-detail",
      "destination": "/api?action=gpt-analysis-detail"
    },
    {
      "source": "/api/gpt/training-start",
      "destination": "/api?action=training-start"
    },
    {
      "source": "/api/gpt/training-status",
      "destination": "/api?action=training-status"
    },
    {
      "source": "/api/gpt/training-next",
      "destination": "/api?action=training-next"
    },
    {
      "source": "/api/gpt/training-record",
      "destination": "/api?action=training-record"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "no-referrer"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        }
      ]
    }
  ]
}
